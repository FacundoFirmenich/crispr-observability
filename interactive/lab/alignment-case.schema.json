{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:read-observability-lab:alignment:1",
  "title": "Read Observability Lab alignment slice",
  "type": "object",
  "required": ["schema","kind","name","format","records"],
  "properties": {
    "schema": {"const": "observability-alignment/1"},
    "kind": {"const": "alignment"},
    "name": {"type": "string", "minLength": 1, "maxLength": 240},
    "format": {"enum": ["SAM","BAM"]},
    "records": {"type": "array", "minItems": 1, "maxItems": 2500, "items": {
      "type": "object",
      "required": ["name","flag","mapq","ref","start","cigar","sequence","quality"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 254},
        "flag": {"type": "integer", "minimum": 0, "maximum": 65535},
        "mapq": {"type": "integer", "minimum": 0, "maximum": 255},
        "ref": {"type": "string", "minLength": 1, "not": {"const": "*"}},
        "start": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "cigar": {"type": "string", "pattern": "^(?:[1-9][0-9]*[MIDNSHP=X])+$", "maxLength": 50000},
        "sequence": {"type": "string", "pattern": "^(?:[*]|[=ACMGRSVTWYHKDBNU]+)$"},
        "quality": {"type": "string", "pattern": "^[!-~]+$"},
        "ordinal": {"type": ["integer","null"], "minimum": 0, "maximum": 2147483647}
      }
    }},
    "source": {"type": "object", "properties": {
      "region": {"type": "object", "required": ["ref","start","end"], "properties": {
        "ref": {"type": "string"}, "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1}
      }}
    }}
  }
}
