FROM python:3.14.10-slim-bookworm@sha256:5dca57ddc56794d9049dee9ee95a7f071b69d3b018368f2ddc61813649ca2fa0
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 CRISPR_REVIEW_OUTPUT=/results
WORKDIR /app
COPY extensions/retained_span_audit/requirements.txt extensions/retained_span_audit/requirements.txt
COPY reproducibility/requirements-reviewer.txt reproducibility/requirements-reviewer.txt
RUN python -m pip install --only-binary=:all: --no-cache-dir -r reproducibility/requirements-reviewer.txt
COPY extensions/retained_span_audit/ extensions/retained_span_audit/
COPY extensions/generation_model/validation/ extensions/generation_model/validation/
COPY interactive/supergraph/ interactive/supergraph/
COPY interactive/lab/CFTR_OBSERVABILITY_LAB.html interactive/lab/CFTR_OBSERVABILITY_LAB.html
COPY docs/ docs/
COPY code/observability_report.py code/observability_report.py
COPY extensions/reproduction/contract/ extensions/reproduction/contract/
COPY reproducibility/reproduce.py reproducibility/reviewer_app.py reproducibility/
COPY reproducibility/reviewer-theme.toml .streamlit/config.toml
RUN mkdir /results && chown 10001:10001 /results
USER 10001:10001
EXPOSE 8501
VOLUME ["/results"]
CMD ["python", "-m", "streamlit", "run", "reproducibility/reviewer_app.py", "--server.address=0.0.0.0", "--server.headless=true"]
